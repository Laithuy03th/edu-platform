# =============================================================================
# Cấu hình mẫu — sao chép thành .env (hoặc .env.local) rồi điền giá trị.
# - Biến KHÔNG bí mật để trống => dùng giá trị mặc định ghi trong comment.
# - Biến bí mật bắt buộc để trống => app báo lỗi thiết lập rõ ràng (không giả lập thành công).
# - Không đặt secret vào biến có tiền tố NEXT_PUBLIC_.
# - Tên biến AUTH_* theo Auth.js v5 (ADR-002); sẽ đổi nếu chọn thư viện khác.
# =============================================================================

# ---- Ứng dụng ---------------------------------------------------------------
# development | test | production. Mặc định: development
APP_ENV=
# URL gốc của app (dùng cho link email, kiểm tra Origin). Mặc định: http://localhost:3000
APP_URL=
# Timezone hiển thị mặc định. Mặc định: Asia/Ho_Chi_Minh
DEFAULT_TIMEZONE=
# Chỉ đặt true khi chạy sau reverse proxy/hosting đã biết (tin header X-Forwarded-*). Mặc định: false
TRUST_PROXY=

# ---- SEO: xác minh quyền sở hữu site (không phải bí mật) ------------------------
# Chỉ phần content của thẻ <meta name="google-site-verification" content="...">. Để trống nếu xác minh bằng DNS.
GOOGLE_SITE_VERIFICATION=
# Chỉ phần content của thẻ <meta name="msvalidate.01" content="..."> (Bing Webmaster Tools).
BING_SITE_VERIFICATION=
# Email liên hệ công khai (hiện ở /lien-he và chính sách bảo mật). Để trống: chỉ hướng dẫn kênh trong ứng dụng.
CONTACT_EMAIL=

# ---- MongoDB Atlas ----------------------------------------------------------
# Bí mật. Chuỗi kết nối của user ứng dụng (quyền readWrite trên DB của app).
MONGODB_URI=
# Tên database. Mặc định: tuhoc_dev
MONGODB_DB_NAME=
# Kích thước pool mỗi instance (Atlas Free tối đa 500 kết nối). Mặc định: 5
MONGODB_MAX_POOL_SIZE=
# Tùy chọn: DB cho integration test. Để trống => dùng mongodb-memory-server.
TEST_MONGODB_URI=

# ---- Xác thực (Auth.js v5) --------------------------------------------------
# Bí mật, >= 32 byte ngẫu nhiên: `openssl rand -base64 32`.
# Đổi giá trị => mọi phiên hiện tại mất hiệu lực (xem AUTH_SECURITY.md §2 về rotation).
AUTH_SECRET=
# Google OAuth (Google Cloud Console > Credentials > OAuth client ID, loại Web application).
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
# Để trống => nút đăng nhập Google bị ẩn.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# true khi chạy sau proxy không phải Vercel (Auth.js yêu cầu để tin Host). Mặc định: false
AUTH_TRUST_HOST=
# Bí mật, khóa HMAC cho key rate limit (không lưu IP thô). `openssl rand -base64 32`
RATE_LIMIT_SECRET=

# ---- Email ------------------------------------------------------------------
# file (chỉ development/test: ghi vào .data/mail/) | smtp.
# Mặc định: smtp nếu có SMTP_HOST hoặc APP_ENV=production; còn lại file.
# Miễn phí: Gmail + App Password (smtp.gmail.com, 465) hoặc Brevo (smtp-relay.brevo.com, 587).
# Kiểm tra: pnpm mail:check   (thêm --send-to=<email> để gửi 1 thư thử)
MAIL_TRANSPORT=
SMTP_HOST=
# Mặc định: 587
SMTP_PORT=
# Bỏ trống để tự suy: port 465 → true (TLS ngay), port khác → false (STARTTLS)
SMTP_SECURE=
SMTP_USER=
# Bí mật
SMTP_PASSWORD=
# Ví dụ: Tự Học <no-reply@example.com>. Với Gmail phải trùng SMTP_USER.
MAIL_FROM=

# ---- Cloudinary (Phase 3) ---------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Bí mật — chỉ server dùng để ký upload, xác minh webhook, gọi Admin API.
CLOUDINARY_API_SECRET=

# ---- Quota & ngân sách (giá trị khởi tạo; admin chỉnh trong app, có audit) --
# Byte chính xác. 1 GiB = 1073741824
QUOTA_STORAGE_BYTES=
# 20 MiB = 20971520
QUOTA_VIDEO_MAX_BYTES=
# Mặc định: 300 (5 phút)
QUOTA_VIDEO_MAX_SECONDS=
# 1 MiB = 1048576
QUOTA_IMAGE_MAX_BYTES=
# Mặc định: 10
QUOTA_VIDEOS_PER_COURSE=
# Mặc định: 2
QUOTA_COURSES_WITH_VIDEO=
# Ngân sách nội bộ Cloudinary (rolling 30 ngày). Mặc định: 18
BUDGET_CLOUDINARY_CREDITS=
# 300 MiB = 314572800
BUDGET_MONGODB_BYTES=
# Snapshot usage cũ hơn số phút này => dừng cấp upload (fail-closed). Mặc định: 1440
USAGE_STALE_AFTER_MINUTES=


# ---- Script vận hành --------------------------------------------------------
# Chỉ đặt true tạm thời khi chạy `pnpm admin:create`. Mặc định: false
ALLOW_ADMIN_BOOTSTRAP=
