{
  "name": "tuhoc-lms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <27"
  },
  "scripts": {
    "dev": "next dev",
    "dev:db": "tsx scripts/dev-mongo.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:indexes": "tsx --conditions=react-server scripts/db-indexes.ts",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.ts",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "media:cleanup": "tsx --conditions=react-server scripts/media-cleanup.ts",
    "media:reconcile": "tsx --conditions=react-server scripts/media-reconcile.ts",
    "mail:check": "tsx --conditions=react-server scripts/mail-check.ts",
    "usage:sync": "tsx --conditions=react-server scripts/usage-sync.ts",
    "bench:argon2": "tsx --conditions=react-server scripts/bench-argon2.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "clsx": "2.1.1",
    "cloudinary": "2.11.0",
    "mongodb": "7.9.1",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "mongodb-memory-server": "11.4.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@11.25.0"
}
